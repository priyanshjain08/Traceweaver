generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         String          @default("admin")
  createdAt    DateTime        @default(now())
  investigations Investigation[]
}

model Project {
  id            String         @id @default(cuid())
  name          String         @unique
  createdAt     DateTime       @default(now())
  environments  Environment[]
  services      Service[]
  dataSources   DataSource[]
  alertRules    AlertRule[]
  investigations Investigation[]
}

model Environment {
  id        String        @id @default(cuid())
  projectId String
  name      String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  traces    Trace[]
  logs      Log[]
  events    SystemEvent[]
  @@unique([projectId, name])
}

model Service {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  description String?
  createdAt   DateTime      @default(now())
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  spans       Span[]
  logs        Log[]
  events      SystemEvent[]
  anomalies   Anomaly[]
  @@unique([projectId, name])
}

model Trace {
  id            String   @id @default(cuid())
  traceId       String
  environmentId String
  rootService   String
  operation     String
  startTime     DateTime
  durationMs    Float
  status        String
  spanCount     Int
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  spans         Span[]
  @@unique([environmentId, traceId])
  @@index([startTime])
  @@index([status, startTime])
  @@index([rootService, startTime])
  @@index([durationMs])
  @@index([traceId])
}

model Span {
  id           String   @id @default(cuid())
  traceRef     String
  spanId       String
  parentSpanId String?
  serviceId    String
  operation    String
  startTime    DateTime
  endTime      DateTime
  durationMs   Float
  status       String
  attributes   Json     @default("{}")
  trace        Trace    @relation(fields: [traceRef], references: [id], onDelete: Cascade)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@unique([traceRef, spanId])
  @@index([serviceId, startTime])
  @@index([startTime])
  @@index([status, startTime])
}

model Log {
  id            String   @id @default(cuid())
  environmentId String
  serviceId     String
  timestamp     DateTime
  level         String
  message       String
  traceId       String?
  spanId        String?
  attributes    Json     @default("{}")
  isDemo        Boolean  @default(false)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@index([timestamp])
  @@index([level, timestamp])
  @@index([serviceId, timestamp])
  @@index([traceId])
}

model SystemEvent {
  id            String   @id @default(cuid())
  environmentId String
  serviceId     String?
  timestamp     DateTime
  type          String
  severity      String
  title         String
  description   String?
  metadata      Json     @default("{}")
  isDemo        Boolean  @default(false)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  @@index([timestamp])
  @@index([type, timestamp])
}

model Anomaly {
  id          String   @id @default(cuid())
  type        String
  serviceId   String
  severity    String
  detectedAt  DateTime @default(now())
  measured    Float
  threshold   Float
  explanation String
  status      String   @default("open") // open | acknowledged | resolved
  traceIds    String[]
  resolvedAt  DateTime?
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@index([status, detectedAt])
  @@index([serviceId, type, detectedAt])
}

model Investigation {
  id             String   @id @default(cuid())
  projectId      String
  createdById    String
  title          String
  description    String   @default("")
  severity       String   @default("medium")
  status         String   @default("open") // open | investigating | resolved | closed
  rootCause      String?
  createdAt      DateTime @default(now())
  closedAt       DateTime?
  traceIds       String[]
  logIds         String[]
  eventIds       String[]
  anomalyIds     String[]
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User     @relation(fields: [createdById], references: [id])
  notes          InvestigationNote[]
  @@index([status, createdAt])
}

model InvestigationNote {
  id              String   @id @default(cuid())
  investigationId String
  body            String
  createdAt       DateTime @default(now())
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
}

model DataSource {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  kind        String   @default("rest")
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  credentials ApiCredential[]
  @@unique([projectId, name])
}

model ApiCredential {
  id           String   @id @default(cuid())
  dataSourceId String
  prefix       String
  keyHash      String   @unique
  createdAt    DateTime @default(now())
  revokedAt    DateTime?
  lastUsedAt   DateTime?
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
}

model AlertRule {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  condition   String   // error_rate | p95_latency | service_unavailable | failed_requests
  threshold   Float
  windowMins  Int      @default(5)
  severity    String   @default("medium")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
